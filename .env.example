# Azure OpenAI deployment in Foundry
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Document Intelligence / Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-formrecognizer-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=YOUR_FORM_RECOGNIZER_KEY

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net
AZURE_SEARCH_KEY=YOUR_SEARCH_KEY
AZURE_SEARCH_INDEX=healthcare-fraud-index

# Azure AI Foundry
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-instance.azure.com
AZURE_FOUNDRY_PROJECT_ID=YOUR_FOUNDRY_PROJECT_ID
AZURE_FOUNDRY_API_KEY=YOUR_FOUNDRY_API_KEY

# External Fraud Scoring API
# For local development, point this to the MCP server fraud scoring endpoint:
# FRAUD_API_URL=http://127.0.0.1:8000/fraud-score
FRAUD_API_URL=https://your-fraud-api.example.com/score
FRAUD_API_KEY=YOUR_FRAUD_API_KEY

# Local MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development
